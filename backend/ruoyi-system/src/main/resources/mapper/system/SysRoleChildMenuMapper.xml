<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.SysRoleChildMenuMapper">

    <resultMap type="SysRoleChildMenu" id="SysRoleChildMenuResult">
        <result property="roleId"    column="role_id"    />
        <result property="childMenuId"    column="child_menu_id"    />
        <association property="childMenu" column="ChildMenu">
            <result property="childMenuId" column="child_menu_id"/>
            <result property="childMenuType" column="child_menu_type"/>
            <result property="childMenuName" column="child_menu_name"/>
        </association>
    </resultMap>

    <sql id="selectSysRoleChildMenuVo">
        select s.role_id, s.child_menu_id,
        c.child_menu_id,c.child_menu_type,c.child_menu_name
         from sys_role_child_menu s
        left join child_menu c on c.child_menu_id = s.child_menu_id
    </sql>

    <select id="selectSysRoleChildMenuList" parameterType="SysRoleChildMenu" resultMap="SysRoleChildMenuResult">
        <include refid="selectSysRoleChildMenuVo"/>
        <where>
            <if test="roleId != null "> and s.role_id = #{roleId}</if>
            <if test="childMenuId != null  and childMenuId != ''"> and s.child_menu_id = #{childMenuId}</if>
            <if test="childMenuType != null  and childMenuType != ''"> and c.child_menu_type = #{childMenuType}</if>
        </where>
    </select>

    <select id="selectSysRoleChildMenuByRoleId" parameterType="Long" resultMap="SysRoleChildMenuResult">
        <include refid="selectSysRoleChildMenuVo"/>
        where s.role_id = #{roleId}
    </select>

    <insert id="insertSysRoleChildMenu" parameterType="SysRoleChildMenu">
        insert into sys_role_child_menu
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="roleId != null">role_id,</if>
            <if test="childMenuId != null">child_menu_id,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="roleId != null">#{roleId},</if>
            <if test="childMenuId != null">#{childMenuId},</if>
         </trim>
    </insert>

    <update id="updateSysRoleChildMenu" parameterType="SysRoleChildMenu">
        update sys_role_child_menu
        <trim prefix="SET" suffixOverrides=",">
            <if test="childMenuId != null">child_menu_id = #{childMenuId},</if>
        </trim>
        where role_id = #{roleId}
    </update>

    <delete id="deleteSysRoleChildMenuByRoleId" parameterType="Long">
        delete from sys_role_child_menu where child_menu_id = #{childMenuId}
    </delete>

    <delete id="deleteSysRoleChildMenuByRoleIds" parameterType="String">
        delete from sys_role_child_menu where child_menu_id in
        <foreach item="childMenuId" collection="array" open="(" separator="," close=")">
            #{childMenuId}
        </foreach>
    </delete>


</mapper>
