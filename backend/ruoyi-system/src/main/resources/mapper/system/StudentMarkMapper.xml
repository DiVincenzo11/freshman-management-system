<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.StudentMarkMapper">
    
    <resultMap type="StudentMark" id="StudentMarkResult">
        <result property="markId"    column="mark_id"    />
        <result property="markContent"    column="mark_content"    />
        <result property="studentId"    column="student_id"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectStudentMarkVo">
        select mark_id, mark_content, student_id, create_time, update_time from student_mark
    </sql>

    <select id="selectStudentMarkList" parameterType="StudentMark" resultMap="StudentMarkResult">
        <include refid="selectStudentMarkVo"/>
        <where>  
            <if test="markContent != null "> and mark_content = #{markContent}</if>
            <if test="studentId != null "> and student_id = #{studentId}</if>
        </where>
    </select>
    
    <select id="selectStudentMarkByMarkId" parameterType="Long" resultMap="StudentMarkResult">
        <include refid="selectStudentMarkVo"/>
        where mark_id = #{markId}
    </select>

    <insert id="insertStudentMark" parameterType="StudentMark" useGeneratedKeys="true" keyProperty="markId">
        insert into student_mark
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="markContent != null">mark_content,</if>
            <if test="studentId != null">student_id,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="markContent != null">#{markContent},</if>
            <if test="studentId != null">#{studentId},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateStudentMark" parameterType="StudentMark">
        update student_mark
        <trim prefix="SET" suffixOverrides=",">
            <if test="markContent != null">mark_content = #{markContent},</if>
            <if test="studentId != null">student_id = #{studentId},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where mark_id = #{markId}
    </update>

    <delete id="deleteStudentMarkByMarkId" parameterType="Long">
        delete from student_mark where mark_id = #{markId}
    </delete>

    <delete id="deleteStudentMarkByMarkIds" parameterType="String">
        delete from student_mark where mark_id in 
        <foreach item="markId" collection="array" open="(" separator="," close=")">
            #{markId}
        </foreach>
    </delete>
</mapper>